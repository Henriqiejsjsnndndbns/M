import math
import wave
import struct
import subprocess
import os

# Configurações
SAMPLE_RATE = 44100
DURATION_PER_BIT = 0.1  # 100ms por bit
FREQ_0 = 800   # Hz
FREQ_1 = 1200  # Hz
OUTPUT_FILE = "tx_puro.wav"

def text_to_bits(text):
    bits = []
    for char in text:
        val = ord(char)
        for i in range(7, -1, -1):
            bits.append((val >> i) & 1)
    return bits

def generate_sine_sample(freq, t):
    """Gera um único sample de onda senoidal"""
    return math.sin(2 * math.pi * freq * t)

def transmit_text(text):
    print(f"[TX] Gerando áudio puro para: '{text}'")
    bits = text_to_bits(text)
    
    samples = []
    samples_per_bit = int(SAMPLE_RATE * DURATION_PER_BIT)
    
    for bit in bits:
        freq = FREQ_1 if bit == 1 else FREQ_0
        for i in range(samples_per_bit):
            t = i / SAMPLE_RATE
            # Aplica envelope suave no início e fim do bit para evitar cliques
            # Hanning window simplificado
            envelope = 0.5 * (1 - math.cos(2 * math.pi * i / (samples_per_bit - 1))) if i < 10 or i > samples_per_bit - 10 else 1.0
            val = generate_sine_sample(freq, t) * envelope
            # Converte para inteiro 16-bit (-32768 a 32767)
            samples.append(int(val * 32767))
            
    print(f"[TX] Gerados {len(samples)} samples.")

    # Salva como WAV
    with wave.open(OUTPUT_FILE, 'w') as wav_file:
        wav_file.setnchannels(1) # Mono
        wav_file.setsampwidth(2) # 2 bytes (16 bits)
        wav_file.setframerate(SAMPLE_RATE)
        # Escreve os dados em binário
        wav_data = struct.pack('<' + 'h' * len(samples), *samples)
        wav_file.writeframes(wav_data)
        
    print(f"[TX] Arquivo salvo: {OUTPUT_FILE}")
    play_audio()

def play_audio():
    print("[TX] Tocando...")
    try:
        subprocess.run(["paplay", OUTPUT_FILE], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        try:
            subprocess.run(["aplay", OUTPUT_FILE], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            print("[AVISO] 'paplay' e 'aplay' não encontrados. Instale com: sudo apt install pulseaudio-utils alsa-utils")
            print(f"Manualmente: aplay {OUTPUT_FILE}")

if __name__ == "__main__":
    transmit_text("SKYNETchat")
    
