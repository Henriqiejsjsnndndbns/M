import numpy as np
import soundfile as sf
import subprocess
import os

# Configurações
SAMPLE_RATE = 44100
DURATION_PER_BIT = 0.1  # Segundos por bit
FREQ_0 = 800   # Hz para bit 0
FREQ_1 = 1200  # Hz para bit 1
OUTPUT_FILE = "tx_output.wav"

def text_to_bits(text):
    """Converte string em lista de bits (0 ou 1)"""
    bits = []
    for char in text:
        val = ord(char)
        for i in range(7, -1, -1):
            bits.append((val >> i) & 1)
    return bits

def generate_tone(freq, duration, sample_rate):
    """Gera um array de áudio para um tom puro"""
    t = np.linspace(0, duration, int(sample_rate * duration), False)
    tone = np.sin(2 * np.pi * freq * t)
    # Envelope suave para evitar cliques
    envelope = np.hanning(len(tone))
    return tone * envelope

def transmit_text(text):
    print(f"[TX] Gerando áudio para: '{text}'")
    bits = text_to_bits(text)
    
    audio_stream = []
    for bit in bits:
        freq = FREQ_1 if bit == 1 else FREQ_0
        tone = generate_tone(freq, DURATION_PER_BIT, SAMPLE_RATE)
        audio_stream.append(tone)
        
    # Concatena todos os tons
    final_audio = np.concatenate(audio_stream)
    
    # Salva em arquivo WAV
    sf.write(OUTPUT_FILE, final_audio, SAMPLE_RATE)
    print(f"[TX] Arquivo salvo: {OUTPUT_FILE}")
    
    # Toca usando o player do sistema (paplay, aplay, ou ffplay)
    print("[TX] Tocando áudio...")
    try:
        # Tenta paplay (PulseAudio/PipeWire - comum no Kali/Gnome)
        subprocess.run(["paplay", OUTPUT_FILE], check=True)
    except FileNotFoundError:
        try:
            # Tenta aplay (ALSA puro)
            subprocess.run(["aplay", OUTPUT_FILE], check=True)
        except FileNotFoundError:
            print("[ERRO] Nenhum player de áudio encontrado. Instale 'pulseaudio-utils' ou 'alsa-utils'.")

if __name__ == "__main__":
    mensagem = "SKYNETchat"
    transmit_text(mensagem)
    
