import wave
import struct
import math
import sys

SAMPLE_RATE = 44100
BIT_DURATION = 0.2  # 200ms por bit
FREQ_0 = 1500       # Frequência para bit 0
FREQ_1 = 2200       # Frequência para bit 1
AMPLITUDE = 32767   # Volume máximo (16-bit signed)

def generate_tone(freq, duration, sample_rate):
    """Gera uma lista de samples para uma onda senoidal."""
    num_samples = int(sample_rate * duration)
    samples = []
    for i in range(num_samples):
        # Fórmula da onda senoidal: Amplitude * sin(2 * pi * freq * t)
        sample = AMPLITUDE * math.sin(2 * math.pi * freq * i / sample_rate)
        samples.append(int(sample))
    return samples

def encode_bit(bit_val):
    """Retorna os samples para um bit específico."""
    freq = FREQ_1 if bit_val == 1 else FREQ_0
    return generate_tone(freq, BIT_DURATION, SAMPLE_RATE)

def main():
    # Dados de exemplo: sequência de bits 1 e 0
    data_bits = [1, 0, 1, 1, 0, 0, 1, 0]
    
    all_samples = []
    for bit in data_bits:
        all_samples.extend(encode_bit(bit))

    # Salvar em arquivo WAV
    filename = "output_audio.wav"
    with wave.open(filename, 'wb') as wav_file:
        wav_file.setnchannels(1)  # Mono
        wav_file.setsampwidth(2)  # 16-bit
        wav_file.setframerate(SAMPLE_RATE)
        
        # Empacotar os samples em binário (short int little-endian)
        for sample in all_samples:
            packed = struct.pack('<h', sample)
            wav_file.writeframes(packed)
            
    print(f"Áudio gerado: {filename}")

if __name__ == "__main__":
    main()
    
