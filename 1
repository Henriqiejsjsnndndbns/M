// ============================================================
// ÁUDIO
// ============================================================

void iniciarAudio()
{
    ledcSetup(
        LEDC_CHANNEL,
        frequenciaAtual,
        LEDC_RESOLUTION
    );

    ledcAttachPin(
        SPEAKER_PIN,
        LEDC_CHANNEL
    );

    ledcWriteTone(
        LEDC_CHANNEL,
        frequenciaAtual
    );

    audioAtivo = true;

    inicioAudio = millis();
    ultimoTom = millis();
}

// ============================================================

void pararAudio()
{
    ledcWriteTone(
        LEDC_CHANNEL,
        0
    );

    audioAtivo = false;
}

// ============================================================

void beepAudio(uint32_t frequencia)
{
    if (frequencia < 10)
        frequencia = 10;

    if (frequencia > 20000)
        frequencia = 20000;

    frequenciaAtual = frequencia;

    ledcSetup(
        LEDC_CHANNEL,
        frequenciaAtual,
        LEDC_RESOLUTION
    );

    ledcAttachPin(
        SPEAKER_PIN,
        LEDC_CHANNEL
    );

    ledcWriteTone(
        LEDC_CHANNEL,
        frequenciaAtual
    );

    totalTons++;

    delay(200);

    ledcWriteTone(
        LEDC_CHANNEL,
        0
    );
}

// ============================================================
// ATUALIZAÇÃO DO ÁUDIO
// ============================================================

void atualizarAudio()
{
    if (!audioAtivo)
        return;

    unsigned long agora = millis();

    if (agora - ultimoTom >= DURACAO_TOM)
    {
        ultimoTom = agora;

        if (audioAtivo)
        {
            ledcWriteTone(
                LEDC_CHANNEL,
                frequenciaAtual
            );

            totalTons++;
            ciclos++;
        }
    }
}

// ============================================================
// WIFI
// ============================================================

void conectarWiFi()
{
    WiFi.mode(WIFI_STA);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.println();
    Serial.println(
        "Conectando ao Wi-Fi..."
    );

    unsigned long inicio = millis();

    while (
        WiFi.status() != WL_CONNECTED &&
        millis() - inicio < 15000
    )
    {
        delay(500);

        Serial.print(".");
    }

    Serial.println();

    if (WiFi.status() == WL_CONNECTED)
    {
        Serial.println(
            "Wi-Fi conectado."
        );

        Serial.print(
            "IP: "
        );

        Serial.println(
            WiFi.localIP()
        );

        Serial.print(
            "RSSI: "
        );

        Serial.println(
            WiFi.RSSI()
        );

        if (
            MDNS.begin("esp32-audio")
        )
        {
            Serial.println(
                "mDNS: http://esp32-audio.local"
            );
        }
    }
    else
    {
        Serial.println(
            "Falha ao conectar Wi-Fi."
        );
    }
}

// ============================================================

void verificarWiFi()
{
    static unsigned long ultimaTentativa = 0;

    if (
        WiFi.status() == WL_CONNECTED
    )
    {
        return;
    }

    if (
        millis() - ultimaTentativa < 10000
    )
    {
        return;
    }

    ultimaTentativa = millis();

    Serial.println(
        "Tentando reconectar Wi-Fi..."
    );

    WiFi.disconnect();

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );
}

// ============================================================
// API STATUS
// ============================================================

void apiStatus()
{
    String json = "{";

    json += "\"wifi\":";
    json +=
        WiFi.status() == WL_CONNECTED
        ? "true"
        : "false";

    json += ",";

    json += "\"ip\":\"";
    json +=
        WiFi.status() == WL_CONNECTED
        ? WiFi.localIP().toString()
        : "0.0.0.0";
    json += "\"";

    json += ",";

    json += "\"rssi\":";
    json +=
        WiFi.status() == WL_CONNECTED
        ? String(WiFi.RSSI())
        : "0";

    json += ",";

    json += "\"audio\":";
    json +=
        audioAtivo
        ? "true"
        : "false";

    json += ",";

    json += "\"frequency\":";
    json += String(frequenciaAtual);

    json += ",";

    json += "\"tones\":";
    json += String(totalTons);

    json += ",";

    json += "\"cycles\":";
    json += String(ciclos);

    json += ",";

    json += "\"uptime\":";
    json += String(
        millis() / 1000
    );

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// API START
// ============================================================

void apiStart()
{
    iniciarAudio();

    server.send(
        200,
        "application/json",
        "{\"ok\":true}"
    );
}

// ============================================================
// API STOP
// ============================================================

void apiStop()
{
    pararAudio();

    server.send(
        200,
        "application/json",
        "{\"ok\":true}"
    );
}

// ============================================================
// API BEEP
// ============================================================

void apiBeep()
{
    uint32_t frequencia =
        frequenciaAtual;

    if (
        server.hasArg("freq")
    )
    {
        frequencia =
            server.arg("freq").toInt();
    }

    beepAudio(
        frequencia
    );

    server.send(
        200,
        "application/json",
        "{\"ok\":true}"
    );
}

