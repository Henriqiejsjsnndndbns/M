// SETUP
// ============================================================

void setup()
{
    Serial.begin(115200);

    delay(1000);

    Serial.println();
    Serial.println(
        "================================"
    );

    Serial.println(
        "ESP32-S3 AUDIO DIAGNOSTICO"
    );

    Serial.println(
        "================================"
    );

    Serial.println();

    Serial.print(
        "CPU: "
    );

    Serial.print(
        ESP.getCpuFreqMHz()
    );

    Serial.println(
        " MHz"
    );

    Serial.print(
        "Flash: "
    );

    Serial.print(
        ESP.getFlashChipSize() /
        (1024 * 1024)
    );

    Serial.println(
        " MB"
    );

    Serial.print(
        "PSRAM: "
    );

    if (psramFound())
    {
        Serial.print(
            ESP.getPsramSize() /
            (1024 * 1024)
        );

        Serial.println(
            " MB"
        );
    }
    else
    {
        Serial.println(
            "NAO DETECTADA"
        );
    }

    Serial.println();

    // GPIO DO ALTO-FALANTE

    pinMode(
        SPEAKER_PIN,
        OUTPUT
    );

    digitalWrite(
        SPEAKER_PIN,
        LOW
    );

    // GPIO DO IR

    pinMode(
        IR_PIN,
        INPUT
    );

    // CONFIGURA LEDC

    ledcSetup(
        LEDC_CHANNEL,
        frequenciaAtual,
        LEDC_RESOLUTION
    );

    ledcAttachPin(
        SPEAKER_PIN,
        LEDC_CHANNEL
    );

    ledcWriteTone(
        LEDC_CHANNEL,
        0
    );

    // WIFI

    conectarWiFi();

    // SERVIDOR WEB

    server.on(
        "/",
        HTTP_GET,
        []()
        {
            server.send_P(
                200,
                "text/html",
                HTML_PAGE
            );
        }
    );

    server.on(
        "/api/status",
        HTTP_GET,
        apiStatus
    );

    server.on(
        "/api/start",
        HTTP_GET,
        apiStart
    );

    server.on(
        "/api/stop",
        HTTP_GET,
        apiStop
    );

    server.on(
        "/api/beep",
        HTTP_GET,
        apiBeep
    );

    server.begin();

    Serial.println(
        "Servidor HTTP iniciado."
    );

    if (
        WiFi.status() == WL_CONNECTED
    )
    {
        Serial.print(
            "Painel: http://"
        );

        Serial.println(
            WiFi.localIP()
        );
    }

    Serial.println();

    Serial.println(
        "GPIO5 = AUDIO"
    );

    Serial.println(
        "GPIO4 = IR"
    );

    Serial.println();

    Serial.println(
        "Sistema pronto."
    );
}

// ============================================================
// LOOP
// ============================================================

void loop()
{
    server.handleClient();

    atualizarAudio();

    verificarWiFi();

    delay(1);
}
