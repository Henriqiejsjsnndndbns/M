import cv2
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image

# Caminho para o mapa de Oronteus Finaeus
image_path = "/home/henry/maps/oronteus_finaeus.jpg"

def load_and_show(image_path):
    try:
        img = Image.open(image_path)
        img_np = np.array(img)
        print(f"Imagem carregada: {img.size}, Modo: {img.mode}")
        
        plt.figure(figsize=(12, 12))
        plt.imshow(img_np)
        plt.title("Mapa de Oronteus Finaeus (1531) - Clique para selecionar GCPs")
        plt.axis('off')
        plt.show()
        return img_np
    except Exception as e:
        print(f"Erro ao carregar imagem: {e}")
        return None

if __name__ == "__main__":
    img_data = load_and_show(image_path)
    
