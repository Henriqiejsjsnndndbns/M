import numpy as np
import wave
import struct
import sys

SAMPLE_RATE = 44100
BIT_DURATION = 0.2  # 200ms por bit
FREQ_0 = 1500       # Frequência para bit 0
FREQ_1 = 2200       # Frequência para bit 1
AMPLITUDE = 32767   # Volume máximo (16-bit signed)

def generate_tone(frequency, duration):
    t = np.linspace(0, duration, int(SAMPLE_RATE * duration), endpoint=False)
    tone = AMPLITUDE * np.sin(2 * np.pi * frequency * t)
    return tone.astype(np.int16)

def text_to_bits(text):
    bits = []
    for char in text:
        bits.extend([int(b) for b in format(ord(char), '08b')])
    return bits

def create_wav(filename, bits):
    audio_data = np.array([], dtype=np.int16)
    
    for bit in bits:
        freq = FREQ_1 if bit else FREQ_0
        tone = generate_tone(freq, BIT_DURATION)
        audio_data = np.append(audio_data, tone)
        
    with wave.open(filename, 'w') as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(SAMPLE_RATE)
        wf.writeframes(audio_data.tobytes())
        
    print(f"[TX] Arquivo '{filename}' gerado ({len(bits)} bits).")
    print(f"[TX] Frequências: 0={FREQ_0}Hz, 1={FREQ_1}Hz | Duração: {BIT_DURATION}s")

if __name__ == "__main__":
    message = "OI"
    if len(sys.argv) > 1:
        message = sys.argv[1]
        
    bits = text_to_bits(message)
    create_wav("tx_puro.wav", bits)
    
