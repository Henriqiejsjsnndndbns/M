import requests

url = "https://upload.wikimedia.org/wikipedia/commons/7/7b/Piri_Reis_map.jpg"
headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "image/jpeg, image/png, image/*",
    "Referer": "https://commons.wikimedia.org/wiki/File:Piri_Reis_map.jpg"
}

response = requests.get(url, headers=headers, stream=True, timeout=30)

if response.status_code == 200:
    with open("/home/henry/maps/piri_reis_raw.jpg", "wb") as f:
        for chunk in response.iter_content(chunk_size=8192):
            f.write(chunk)
    print("Download concluído com sucesso.")
else:
    print(f"Erro: Status {response.status_code}")
    print(f"Conteúdo recebido: {response.text[:100]}")
    
