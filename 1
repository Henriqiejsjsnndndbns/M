import wave
import struct
import math

SAMPLE_RATE = 44100
DURATION = 2.0  # 2 segundos de áudio contínuo
AMPLITUDE_BASE = 16000

def generate_complex_wave(duration, sample_rate):
    """Gera uma onda composta por 3 harmônicos com fases deslocadas."""
    num_samples = int(sample_rate * duration)
    samples = []
    
    # Frequências da portadora e moduladoras
    f1 = 440    # Lá (A4)
    f2 = 880    # Uma oitava acima
    f3 = 1320   # Quinta da oitava acima
    
    for i in range(num_samples):
        t = i / sample_rate
        
        # Síntese aditiva: soma de 3 senoides
        # Usamos matemática para criar interferência construtiva e destrutiva
        s1 = math.sin(2 * math.pi * f1 * t)
        s2 = 0.5 * math.sin(2 * math.pi * f2 * t + math.pi/4) # +45 graus de fase
        s3 = 0.25 * math.sin(2 * math.pi * f3 * t - math.pi/2) # -90 graus de fase
        
        # Combinação e normalização básica para não saturar (clipar)
        combined = (s1 + s2 + s3) / 1.75 
        
        sample = int(AMPLITUDE_BASE * combined)
        samples.append(sample)
        
    return samples

def main():
    all_samples = generate_complex_wave(DURATION, SAMPLE_RATE)
    
    filename = "complex_audio.wav"
    with wave.open(filename, 'wb') as wav_file:
        wav_file.setnchannels(1)
        wav_file.setsampwidth(2)
        wav_file.setframerate(SAMPLE_RATE)
        
        for sample in all_samples:
            packed = struct.pack('<h', sample)
            wav_file.writeframes(packed)
            
    print(f"Áudio complexo gerado: {filename} ({len(all_samples)} samples)")

if __name__ == "__main__":
    main()
    
