// ============================================================
// WI-FI
// ============================================================

const char* WIFI_SSID     = "INFORNET_MARIANA";
const char* WIFI_PASSWORD = "anamaria";

// ============================================================
// HARDWARE
// ============================================================

constexpr uint8_t SPEAKER_PIN       = 5;
constexpr uint8_t SPEAKER_CHANNEL   = 0;
constexpr uint8_t SPEAKER_RESOLUTION = 8;

// ============================================================
// SERVIDOR
// ============================================================

WebServer server(80);

// ============================================================
// SEQUÊNCIA DE TONS
// ============================================================

const uint16_t TONES[] = {
    500,
    800,
    1000,
    1500,
    2000
};

constexpr size_t TONE_COUNT =
    sizeof(TONES) / sizeof(TONES[0]);

constexpr uint32_t TONE_DURATION_MS  = 650;
constexpr uint32_t PAUSE_DURATION_MS = 250;
constexpr uint32_t MANUAL_DURATION_MS = 1200;
constexpr uint32_t WIFI_RETRY_MS = 5000;

// ============================================================
// ESTADO
// ============================================================

bool sequenceRunning = false;
bool pausePhase = false;
bool manualRunning = false;
bool wifiConnected = false;
bool mdnsStarted = false;

uint8_t toneIndex = 0;

uint32_t currentFrequency = TONES[0];

uint32_t totalTones = 0;
uint32_t totalCycles = 0;

uint32_t phaseStarted = 0;
uint32_t manualEnds = 0;
uint32_t lastWifiCheck = 0;

// ============================================================
// VALIDAÇÃO DE FREQUÊNCIA
// ============================================================

bool validFrequency(uint32_t frequency)
{
    return frequency >= 50 &&
           frequency <= 10000;
}

// ============================================================
// PARAR ÁUDIO
// ============================================================

void stopAudio()
{
    ledcWriteTone(
        SPEAKER_CHANNEL,
        0
    );

    digitalWrite(
        SPEAKER_PIN,
        LOW
    );

    sequenceRunning = false;
    pausePhase = false;
    manualRunning = false;
}

// ============================================================
// CONFIGURAR FREQUÊNCIA
// ============================================================

void configureFrequency(uint32_t frequency)
{
    if (!validFrequency(frequency))
    {
        return;
    }

    currentFrequency = frequency;

    ledcSetup(
        SPEAKER_CHANNEL,
        currentFrequency,
        SPEAKER_RESOLUTION
    );

    ledcWriteTone(
        SPEAKER_CHANNEL,
        currentFrequency
    );
}

// ============================================================
// INICIAR TOM DA SEQUÊNCIA
// ============================================================

void startTone()
{
    currentFrequency =
        TONES[toneIndex];

    ledcSetup(
        SPEAKER_CHANNEL,
        currentFrequency,
        SPEAKER_RESOLUTION
    );

    ledcWriteTone(
        SPEAKER_CHANNEL,
        currentFrequency
    );

    sequenceRunning = true;
    pausePhase = false;
    manualRunning = false;

    phaseStarted = millis();

    totalTones++;

    Serial.print(
        "Tom "
    );

    Serial.print(
        toneIndex + 1
    );

    Serial.print(
        "/"
    );

    Serial.print(
        TONE_COUNT
    );

    Serial.print(
        " -> "
    );

    Serial.print(
        currentFrequency
    );

    Serial.println(
        " Hz"
    );
}

// ============================================================
// INICIAR SEQUÊNCIA
// ============================================================

void startSequence()
{
    stopAudio();

    toneIndex = 0;

    startTone();

    Serial.println(
        "Teste de sequência iniciado."
    );
}

// ============================================================
// ATUALIZAR ÁUDIO
// ============================================================

void updateAudio()
{
    uint32_t now = millis();

    // --------------------------------------------------------
    // TESTE MANUAL
    // --------------------------------------------------------

    if (manualRunning)
    {
        if (
            (int32_t)(now - manualEnds) >= 0
        )
        {
            stopAudio();
        }

        return;
    }

    // --------------------------------------------------------
    // SEQUÊNCIA DESLIGADA
    // --------------------------------------------------------

    if (!sequenceRunning)
    {
        return;
    }

    // --------------------------------------------------------
    // TOM TOCANDO
    // --------------------------------------------------------

    if (!pausePhase)
    {
        if (
            now - phaseStarted >=
            TONE_DURATION_MS
        )
        {
            ledcWriteTone(
                SPEAKER_CHANNEL,
                0
            );

            digitalWrite(
                SPEAKER_PIN,
                LOW
            );

            pausePhase = true;

            phaseStarted = now;
        }

        return;
    }

    // --------------------------------------------------------
    // PAUSA
    // --------------------------------------------------------

    if (
        now - phaseStarted >=
        PAUSE_DURATION_MS
    )
    {
        toneIndex++;

        if (
            toneIndex >= TONE_COUNT
        )
        {
            toneIndex = 0;

            totalCycles++;

            Serial.println(
                "Sequência completa."
            );
        }

        startTone();
    }
}

// ============================================================
// TESTE MANUAL
// ============================================================

void startManualTest(uint32_t frequency)
{
    if (!validFrequency(frequency))
    {
        return;
    }

    stopAudio();

    currentFrequency = frequency;

    ledcSetup(
        SPEAKER_CHANNEL,
        currentFrequency,
        SPEAKER_RESOLUTION
    );

    ledcWriteTone(
        SPEAKER_CHANNEL,
        currentFrequency
    );

    manualRunning = true;

    manualEnds =
        millis() + MANUAL_DURATION_MS;

    totalTones++;

    Serial.print(
        "Teste manual: "
    );

    Serial.print(
        currentFrequency
    );

    Serial.println(
        " Hz"
    );
}

// ============================================================
// WIFI
// ============================================================

void connectWiFi()
{
    Serial.println();
    Serial.println(
        "========================================"
    );
    Serial.println(
        " CONEXÃO WI-FI"
    );
    Serial.println(
        "========================================"
    );

    WiFi.mode(
        WIFI_STA
    );

    WiFi.setAutoReconnect(
        true
    );

    WiFi.persistent(
        false
    );

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.print(
        "Conectando"
    );

    uint32_t started =
        millis();

    while (
        WiFi.status() != WL_CONNECTED &&
        millis() - started < 10000
    )
    {
        delay(250);

        Serial.print(
            "."
        );
    }

    Serial.println();

    wifiConnected =
        WiFi.status() ==
        WL_CONNECTED;

    if (wifiConnected)
    {
        Serial.println(
            "Wi-Fi conectado!"
        );

        Serial.print(
            "SSID: "
        );

        Serial.println(
            WIFI_SSID
        );

        Serial.print(
            "IP: "
        );

        Serial.println(
            WiFi.localIP()
        );

        Serial.print(
            "RSSI: "
        );

        Serial.print(
            WiFi.RSSI()
        );

        Serial.println(
            " dBm"
        );

        if (
            !mdnsStarted &&
            MDNS.begin(
                "esp32-audio"
            )
        )
        {
            mdnsStarted = true;

            Serial.println(
                "mDNS: http://esp32-audio.local"
            );
        }
    }
    else
    {
        Serial.println(
            "Wi-Fi não conectado."
        );

        Serial.println(
            "O teste de áudio continuará."
        );
    }
}

// ============================================================
// VERIFICAR WIFI
// ============================================================

void checkWiFi()
{
    uint32_t now =
        millis();

    if (
        now - lastWifiCheck <
        WIFI_RETRY_MS
    )
    {
        return;
    }

    lastWifiCheck =
        now;

    if (
        WiFi.status() ==
        WL_CONNECTED
    )
    {
        wifiConnected = true;

        return;
    }

    wifiConnected = false;

    Serial.println(
        "Wi-Fi desconectado."
    );

    Serial.println(
        "Tentando reconectar..."
    );

    WiFi.disconnect();

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );
}

