// ============================================================
// API STATUS
// ============================================================

void handleStatus()
{
    wifiConnected =
        WiFi.status() ==
        WL_CONNECTED;

    String json;

    json.reserve(500);

    json += "{";

    json += "\"wifi\":";
    json +=
        wifiConnected
        ? "true"
        : "false";

    json += ",\"ip\":\"";
    json +=
        WiFi.localIP()
            .toString();

    json += "\"";

    json += ",\"rssi\":";
    json +=
        wifiConnected
        ? String(WiFi.RSSI())
        : String(0);

    json += ",\"audio\":";
    json +=
        (
            sequenceRunning ||
            manualRunning
        )
        ? "true"
        : "false";

    json += ",\"manual\":";
    json +=
        manualRunning
        ? "true"
        : "false";

    json += ",\"freq\":";
    json +=
        currentFrequency;

    json += ",\"tom\":";
    json +=
        toneIndex + 1;

    json += ",\"count\":";
    json +=
        TONE_COUNT;

    json += ",\"tones\":";
    json +=
        totalTones;

    json += ",\"cycles\":";
    json +=
        totalCycles;

    json += ",\"uptime\":";
    json +=
        millis() / 1000;

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// API START
// ============================================================

void handleStart()
{
    startSequence();

    server.send(
        200,
        "text/plain",
        "OK"
    );
}

// ============================================================
// API STOP
// ============================================================

void handleStop()
{
    stopAudio();

    server.send(
        200,
        "text/plain",
        "OK"
    );
}

// ============================================================
// API BEEP
// ============================================================

void handleBeep()
{
    if (
        !server.hasArg("f")
    )
    {
        server.send(
            400,
            "text/plain",
            "Parametro f ausente"
        );

        return;
    }

    uint32_t frequency =
        server.arg(
            "f"
        ).toInt();

    if (
        !validFrequency(
            frequency
        )
    )
    {
        server.send(
            400,
            "text/plain",
            "Frequencia invalida"
        );

        return;
    }

    startManualTest(
        frequency
    );

    server.send(
        200,
        "text/plain",
        "OK"
    );
}

