// ============================================================
// WIFI
// ============================================================

void conectarWiFi()
{
    Serial.println();
    Serial.println("================================");
    Serial.println(" CONEXÃO WI-FI");
    Serial.println("================================");

    WiFi.mode(WIFI_STA);

    WiFi.setAutoReconnect(true);

    WiFi.persistent(false);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.print("Conectando");

    unsigned long inicio = millis();

    while (
        WiFi.status() != WL_CONNECTED &&
        millis() - inicio < 15000
    )
    {
        delay(400);

        Serial.print(".");
    }

    Serial.println();

    if (
        WiFi.status() == WL_CONNECTED
    )
    {
        wifiOK = true;

        Serial.println(
            "Wi-Fi conectado!"
        );

        Serial.print(
            "SSID: "
        );

        Serial.println(
            WIFI_SSID
        );

        Serial.print(
            "IP: "
        );

        Serial.println(
            WiFi.localIP()
        );

        Serial.print(
            "RSSI: "
        );

        Serial.print(
            WiFi.RSSI()
        );

        Serial.println(
            " dBm"
        );

        // mDNS
        if (
            MDNS.begin(
                "esp32-audio"
            )
        )
        {
            mdnsOK = true;

            Serial.println(
                "mDNS: http://esp32-audio.local"
            );
        }
    }
    else
    {
        wifiOK = false;

        Serial.println(
            "Falha na conexão Wi-Fi."
        );
    }
}

// ============================================================
// AUDIO
// ============================================================

void configurarAudio(
    int frequencia
)
{
    if (frequencia < 50)
        frequencia = 50;

    if (frequencia > 10000)
        frequencia = 10000;

    frequenciaAtual = frequencia;

    // API compatível com Arduino-ESP32 2.x
    ledcSetup(
        SPEAKER_CHANNEL,
        frequenciaAtual,
        SPEAKER_BITS
    );

    ledcAttachPin(
        SPEAKER_PIN,
        SPEAKER_CHANNEL
    );

    if (audioAtivo)
    {
        ledcWriteTone(
            SPEAKER_CHANNEL,
            frequenciaAtual
        );
    }
    else
    {
        ledcWriteTone(
            SPEAKER_CHANNEL,
            0
        );
    }
}

// ============================================================
// INICIAR TOM
// ============================================================

void iniciarTom()
{
    frequenciaAtual =
        tons[indiceTom];

    configurarAudio(
        frequenciaAtual
    );

    audioAtivo = true;
    pausa = false;

    inicioTom = millis();

    totalTons++;

    tomAtual =
        indiceTom + 1;

    Serial.print(
        "Tom "
    );

    Serial.print(
        tomAtual
    );

    Serial.print(
        "/"
    );

    Serial.print(
        quantidadeTons
    );

    Serial.print(
        " -> "
    );

    Serial.print(
        frequenciaAtual
    );

    Serial.println(
        " Hz"
    );
}

// ============================================================
// PARAR AUDIO
// ============================================================

void pararAudio()
{
    audioAtivo = false;

    ledcWriteTone(
        SPEAKER_CHANNEL,
        0
    );

    digitalWrite(
        SPEAKER_PIN,
        LOW
    );
}

// ============================================================
// INICIAR TESTE
// ============================================================

void iniciarTeste()
{
    audioAtivo = true;

    indiceTom = 0;

    iniciarTom();

    Serial.println(
        "Teste iniciado."
    );
}

// ============================================================
// ATUALIZAÇÃO DA SEQUÊNCIA
// ============================================================

void atualizarSequencia()
{
    unsigned long agora =
        millis();

    if (!audioAtivo)
        return;

    // ----------------------------
    // TOCANDO
    // ----------------------------

    if (!pausa)
    {
        if (
            agora - inicioTom
            >= DURACAO_TOM
        )
        {
            ledcWriteTone(
                SPEAKER_CHANNEL,
                0
            );

            pausa = true;

            inicioPausa = agora;
        }
    }

    // ----------------------------
    // PAUSA
    // ----------------------------

    else
    {
        if (
            agora - inicioPausa
            >= DURACAO_PAUSA
        )
        {
            indiceTom++;

            if (
                indiceTom >= quantidadeTons
            )
            {
                indiceTom = 0;

                totalCiclos++;

                Serial.println(
                    "Sequência concluída."
                );
            }

            iniciarTom();
        }
    }
}

// ============================================================
// RECONEXÃO WIFI
// ============================================================

void verificarWiFi()
{
    unsigned long agora =
        millis();

    if (
        agora - ultimoTesteWiFi
        < INTERVALO_WIFI
    )
    {
        return;
    }

    ultimoTesteWiFi =
        agora;

    if (
        WiFi.status() != WL_CONNECTED
    )
    {
        wifiOK = false;

        Serial.println(
            "Wi-Fi desconectado. Reconectando..."
        );

        WiFi.disconnect();

        WiFi.begin(
            WIFI_SSID,
            WIFI_PASSWORD
        );
    }
    else
    {
        wifiOK = true;
    }
}

// ============================================================
// API STATUS
// ============================================================

void enviarStatus()
{
    wifiOK =
        WiFi.status() ==
        WL_CONNECTED;

    String json;

    json.reserve(600);

    json += "{";

    json += "\"wifi\":";
    json += wifiOK
        ? "true"
        : "false";

    json += ",\"ip\":\"";
    json += WiFi.localIP().toString();
    json += "\"";

    json += ",\"rssi\":";
    json += wifiOK
        ? WiFi.RSSI()
        : 0;

    json += ",\"audio\":";
    json += audioAtivo
        ? "true"
        : "false";

    json += ",\"frequencia\":";
    json += frequenciaAtual;

    json += ",\"tom\":";
    json += tomAtual;

    json += ",\"quantidade\":";
    json += quantidadeTons;

    json += ",\"tons\":";
    json += totalTons;

    json += ",\"ciclos\":";
    json += totalCiclos;

    json += ",\"uptime\":";
    json += millis() / 1000;

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

