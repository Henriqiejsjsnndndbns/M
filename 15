// ============================================================
// API BEEP MANUAL
// ============================================================

void apiBeep()
{
    if (!server.hasArg("f"))
    {
        server.send(
            400,
            "text/plain",
            "Frequencia ausente"
        );

        return;
    }

    int frequencia =
        server
            .arg("f")
            .toInt();

    if (
        frequencia < 50 ||
        frequencia > 10000
    )
    {
        server.send(
            400,
            "text/plain",
            "Frequencia invalida"
        );

        return;
    }

    audioAtivo = true;

    configurarAudio(
        frequencia
    );

    frequenciaAtual =
        frequencia;

    totalTons++;

    server.send(
        200,
        "text/plain",
        "OK"
    );
}

