// ===============================
// STATUS
// ===============================

void handleStatus()
{

    unsigned long agora = millis();

    bool sinalRecente =
        (ultimoSinal != 0 &&
         (agora - ultimoSinal) < 1500);

    String tempo;

    if (ultimoSinal == 0)
    {
        tempo = "Nenhum";
    }
    else
    {
        tempo =
            String(agora - ultimoSinal) +
            " ms atrás";
    }

    String json = "{";

    json += "\"sensor\":\"OK\"";

    json += ",\"sinal\":";
    json += sinalRecente ? "true" : "false";

    json += ",\"sinais\":";
    json += String(sinaisDetectados);

    json += ",\"protocolo\":\"";
    json += ultimoProtocolo;
    json += "\"";

    json += ",\"codigo\":\"";
    json += ultimoCodigo;
    json += "\"";

    json += ",\"bits\":";
    json += ultimoBits;

    json += ",\"tempo\":\"";
    json += tempo;
    json += "\"";

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ===============================
// PÁGINA PRINCIPAL
// ===============================

void handleRoot()
{
    server.send(
        200,
        "text/html",
        pagina
    );
}

// ===============================
// SETUP
// ===============================

void setup()
{

    Serial.begin(115200);

    delay(1000);

    Serial.println();
    Serial.println("==============================");
    Serial.println(" ESP32-S3 IR TESTE");
    Serial.println("==============================");

    Serial.println("GPIO IR: GPIO 4");

    // Inicializa receptor IR
    irrecv.enableIRIn();

    Serial.println("Receptor IR iniciado.");

    // WiFi
    WiFi.mode(WIFI_STA);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.print("Conectando ao WiFi");

    while (
        WiFi.status() != WL_CONNECTED
    )
    {
        delay(500);
        Serial.print(".");
    }

    Serial.println();

    Serial.println("WiFi conectado!");

    Serial.print("IP: ");
    Serial.println(WiFi.localIP());

    // Servidor
    server.on(
        "/",
        handleRoot
    );

    server.on(
        "/status",
        handleStatus
    );

    server.begin();

    Serial.println(
        "Servidor HTTP iniciado."
    );

    Serial.println(
        "Aguardando controle remoto..."
    );
}

// ===============================
// LOOP
// ===============================

void loop()
{

    server.handleClient();

    if (irrecv.decode(&results))
    {

        sinaisDetectados++;

        ultimoSinal = millis();

        // Protocolo
        ultimoProtocolo =
            typeToString(
                results.decode_type
            );

        // Código hexadecimal
        ultimoCodigo =
            uint64ToString(
                results.value,
                16
            );

        // Quantidade de bits
        ultimoBits =
            String(results.bits);

        Serial.println();
        Serial.println(
            "========== IR =========="
        );

        Serial.print(
            "Protocolo: "
        );

        Serial.println(
            ultimoProtocolo
        );

        Serial.print(
            "Codigo: 0x"
        );

        Serial.println(
            ultimoCodigo
        );

        Serial.print(
            "Bits: "
        );

        Serial.println(
            ultimoBits
        );

        Serial.println(
            "========================"
        );

        // Pronto para próximo sinal
        irrecv.resume();
    }

    delay(1);
}
