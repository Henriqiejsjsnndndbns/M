#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>

const char* WIFI_SSID = "SEU_WIFI";
const char* WIFI_PASSWORD = "SUA_SENHA";

#define IR_PIN 4

WebServer server(80);

volatile unsigned long pulsosIR = 0;
unsigned long ultimoPulso = 0;

void IRAM_ATTR detectarIR()
{
    pulsosIR++;
    ultimoPulso = millis();
}

