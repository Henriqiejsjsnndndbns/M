void handleRoot()
{
    server.send(200, "text/html", pagina);
}


void handleStatus()
{
    unsigned long agora = millis();

    bool conectado =
        (agora - ultimoPulso < 2000);

    String ultimo;

    if (ultimoPulso == 0)
        ultimo = "Nenhum";
    else
        ultimo = String(agora - ultimoPulso) + " ms atrás";

    String json = "{";

    json += "\"conectado\":";
    json += conectado ? "true" : "false";

    json += ",\"pulsos\":";
    json += String(pulsosIR);

    json += ",\"ultimo\":\"";
    json += ultimo;
    json += "\"";

    json += "}";

    server.send(200, "application/json", json);
}


void setup()
{
    Serial.begin(115200);

    pinMode(IR_PIN, INPUT);

    attachInterrupt(
        digitalPinToInterrupt(IR_PIN),
        detectarIR,
        CHANGE
    );

    Serial.println();
    Serial.println("==============================");
    Serial.println(" ESP32-S3 - TESTE IR");
    Serial.println("==============================");

    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    Serial.print("Conectando ao WiFi");

    while (WiFi.status() != WL_CONNECTED)
    {
        delay(500);
        Serial.print(".");
    }

    Serial.println();
    Serial.println("WiFi conectado!");

    Serial.print("IP: ");
    Serial.println(WiFi.localIP());

    server.on("/", handleRoot);
    server.on("/status", handleStatus);

    server.begin();

    Serial.println("Servidor HTTP iniciado.");
}


void loop()
{
    server.handleClient();
}
