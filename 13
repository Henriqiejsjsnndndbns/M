// ===============================
// STATUS JSON
// ===============================
void enviarStatus()
{
    String json = "{";

    json += "\"wifi\":";
    json += wifiOK ? "true" : "false";

    json += ",\"ip\":\"";
    json += WiFi.localIP().toString();
    json += "\"";

    json += ",\"teste\":";
    json += testeAtivo ? "true" : "false";

    json += ",\"frequencia\":";
    json += frequenciaAtual;

    json += ",\"tom\":";
    json += tomAtual;

    json += ",\"total\":";
    json += totalTestes;

    json += ",\"uptime\":";
    json += millis() / 1000;

    json += ",\"quantidade\":";
    json += quantidadeTons;

    json += "}";

    server.send(200, "application/json", json);
}

// ===============================
// CONTROLE DO AUDIO
// ===============================
void iniciarTom()
{
    frequenciaAtual = tons[indiceTom];
    tomAtual = indiceTom + 1;

    ledcAttach(SPEAKER_PIN, frequenciaAtual, 8);

    ledcWriteTone(
        SPEAKER_PIN,
        frequenciaAtual
    );

    esperandoPausa = false;

    ultimoEvento = millis();

    Serial.print("Tom: ");
    Serial.print(tomAtual);

    Serial.print(" | Frequência: ");
    Serial.print(frequenciaAtual);

    Serial.println(" Hz");
}

void pararTom()
{
    ledcWriteTone(
        SPEAKER_PIN,
        0
    );

    ledcDetach(SPEAKER_PIN);

    esperandoPausa = true;

    ultimoEvento = millis();
}

// ===============================
// SETUP
// ===============================
void setup()
{
    Serial.begin(115200);

    delay(1000);

    Serial.println();
    Serial.println("==============================");
    Serial.println(" ESP32-S3 TESTE DE AUDIO");
    Serial.println("==============================");

    // GPIO
    pinMode(SPEAKER_PIN, OUTPUT);

    Serial.println("GPIO 5 configurado.");

    // WIFI
    WiFi.mode(WIFI_STA);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.print("Conectando ao Wi-Fi");

    unsigned long inicioWiFi = millis();

    while (
        WiFi.status() != WL_CONNECTED &&
        millis() - inicioWiFi < 15000
    )
    {
        delay(500);

        Serial.print(".");
    }

    Serial.println();

    if (WiFi.status() == WL_CONNECTED)
    {
        wifiOK = true;

        Serial.println("Wi-Fi conectado.");

        Serial.print("IP: ");
        Serial.println(WiFi.localIP());
    }
    else
    {
        wifiOK = false;

        Serial.println(
            "Não foi possível conectar ao Wi-Fi."
        );
    }

    // SERVIDOR
    server.on(
        "/",
        []()
        {
            server.send(
                200,
                "text/html",
                paginaHTML()
            );
        }
    );

    server.on(
        "/status",
        enviarStatus
    );

    server.begin();

    Serial.println("Servidor HTTP iniciado.");
    Serial.println();

    inicioTeste = millis();

    testeAtivo = true;

    indiceTom = 0;

    iniciarTom();
}

// ===============================
// LOOP
// ===============================
void loop()
{
    server.handleClient();

    unsigned long agora = millis();

    // ===========================
    // FINAL DO TOM
    // ===========================
    if (!esperandoPausa)
    {
        if (agora - ultimoEvento >= tempoTom)
        {
            pararTom();
        }
    }

    // ===========================
    // PRÓXIMO TOM
    // ===========================
    else
    {
        if (agora - ultimoEvento >= pausaTom)
        {
            indiceTom++;

            if (indiceTom >= quantidadeTons)
            {
                indiceTom = 0;

                totalTestes++;

                Serial.println(
                    "Sequência concluída."
                );

                Serial.println();
            }

            iniciarTom();
        }
    }
}
