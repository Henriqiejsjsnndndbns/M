#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>

// ===============================
// WIFI
// ===============================
const char* WIFI_SSID     = "INFORNET_MARIANA";
const char* WIFI_PASSWORD = "anamaria";

// ===============================
// HARDWARE
// ===============================
#define SPEAKER_PIN 5

// ===============================
// SERVIDOR
// ===============================
WebServer server(80);

// ===============================
// ESTADO DO TESTE
// ===============================
bool wifiOK = false;
bool testeAtivo = false;

unsigned long inicioTeste = 0;
unsigned long totalTestes = 0;

int frequenciaAtual = 0;
int tomAtual = 0;

// ===============================
// SEQUÊNCIA DE TONS
// ===============================
const int tons[] = {
    1000,
    1500,
    2000,
    1500
};

const int quantidadeTons = sizeof(tons) / sizeof(tons[0]);

int indiceTom = 0;

unsigned long ultimoEvento = 0;

const unsigned long tempoTom = 600;
const unsigned long pausaTom = 250;

bool esperandoPausa = false;

// ===============================
// HTML
// ===============================
