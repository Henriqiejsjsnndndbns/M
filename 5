// ------------------------------------------------------------
// PARTICOES
// ------------------------------------------------------------

void diagnosticoParticoes()
{
    titulo("3. PARTICOES DA FLASH");

    esp_partition_iterator_t iterator =
        esp_partition_find(
            ESP_PARTITION_TYPE_ANY,
            ESP_PARTITION_SUBTYPE_ANY,
            NULL);

    if (iterator == NULL)
    {
        Serial.println("Nenhuma particao encontrada.");
        return;
    }

    int contador = 0;

    while (iterator != NULL)
    {
        const esp_partition_t *part =
            esp_partition_get(iterator);

        if (part != NULL)
        {
            contador++;

            Serial.printf(
                "[%d] label=%s | tipo=%u | subtipo=%u | endereco=0x%08X | tamanho=%u bytes\n",
                contador,
                part->label,
                (unsigned)part->type,
                (unsigned)part->subtype,
                (unsigned)part->address,
                (unsigned)part->size
            );

            Serial.printf(
                "    tamanho=%.2f MB | encrypted=%s\n",
                part->size / 1048576.0,
                part->encrypted ? "SIM" : "NAO"
            );
        }

        iterator = esp_partition_next(iterator);
    }

    esp_partition_iterator_release(iterator);

    Serial.printf("\nTotal de particoes: %d\n", contador);
}

// ------------------------------------------------------------
