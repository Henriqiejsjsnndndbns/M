// ------------------------------------------------------------
// WIFI
// ------------------------------------------------------------

void diagnosticoWiFi()
{
    titulo("8. WIFI — SCAN SEM CONEXAO");

    WiFi.mode(WIFI_STA);
    WiFi.disconnect(false, false);

    delay(300);

    Serial.println("Executando scan...");
    Serial.println("Nenhuma rede sera conectada.");

    int quantidade = WiFi.scanNetworks(
        false,
        true
    );

    if (quantidade < 0)
    {
        Serial.printf(
            "Resultado do scan    : ERRO (%d)\n",
            quantidade
        );

        WiFi.scanDelete();
        return;
    }

    Serial.printf(
        "Redes encontradas     : %d\n",
        quantidade
    );

    for (int i = 0; i < quantidade; i++)
    {
        Serial.printf(
            "[%02d] RSSI=%4d dBm | canal=%2d | %s\n",
            i + 1,
            WiFi.RSSI(i),
            WiFi.channel(i),
            WiFi.SSID(i).c_str()
        );
    }

    WiFi.scanDelete();

    Serial.println();
    Serial.println("Status: scan concluido sem conectar em nenhuma rede.");
}

