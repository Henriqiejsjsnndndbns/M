void diagnosticoPSRAM()
{
    titulo("4. PSRAM");

    uint32_t psram = ESP.getPsramSize();
    uint32_t livre = ESP.getFreePsram();

    Serial.printf("PSRAM detectada        : %s\n",
                  psram > 0 ? "SIM" : "NAO");

    Serial.printf("PSRAM total            : %u bytes\n",
                  psram);

    Serial.printf("PSRAM total            : %.2f MB\n",
                  psram / 1048576.0);

    Serial.printf("PSRAM livre            : %u bytes\n",
                  livre);

    if (psram > 0)
    {
        size_t maiorBloco =
            heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM);

        Serial.printf("Maior bloco livre      : %u bytes\n",
                      (unsigned)maiorBloco);

        // Teste pequeno, temporario e nao destrutivo.
        uint8_t *teste = (uint8_t *)ps_malloc(128);

        if (teste != nullptr)
        {
            for (int i = 0; i < 128; i++)
                teste[i] = (uint8_t)i;

            bool correto = true;

            for (int i = 0; i < 128; i++)
            {
                if (teste[i] != (uint8_t)i)
                {
                    correto = false;
                    break;
                }
            }

            free(teste);

            Serial.printf(
                "Teste RAM PSRAM       : %s\n",
                correto ? "OK" : "FALHA"
            );
        }
        else
        {
            Serial.println("Teste RAM PSRAM       : NAO FOI POSSIVEL ALOCAR");
        }
    }
    else
    {
        Serial.println("Teste PSRAM            : NAO EXECUTADO");
        Serial.println("Motivo                 : PSRAM nao detectada pelo firmware.");
    }
}

