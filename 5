    titulo("20. NVS");

    nvs_stats_t stats;

    esp_err_t resultado =
        nvs_get_stats(NULL, &stats);

    if (resultado != ESP_OK)
    {
        Serial.printf(
            "Erro lendo estatisticas NVS: %d\n",
            resultado
        );

        return;
    }

    Serial.printf(
        "Total de paginas       : %lu\n",
        (unsigned long)stats.total_entries
    );

    Serial.printf(
        "Entradas usadas        : %lu\n",
        (unsigned long)stats.used_entries
    );

    Serial.printf(
        "Entradas livres        : %lu\n",
        (unsigned long)stats.free_entries
    );

    Serial.printf(
        "Entradas disponiveis   : %lu\n",
        (unsigned long)stats.available_entries
    );

    Serial.println();
    Serial.println("NVS somente foi consultada.");
    Serial.println("Nenhum dado foi escrito.");
}

