// ============================================================

void diagnosticoParticoes() {
    titulo("3. TABELA DE PARTIÇÕES");

    Serial.println(
        "Esta leitura apenas consulta a tabela. Nenhuma partição será alterada."
    );

    esp_partition_iterator_t iterator =
        esp_partition_find(
            ESP_PARTITION_TYPE_ANY,
            ESP_PARTITION_SUBTYPE_ANY,
            NULL
        );

    if (iterator == NULL) {
        Serial.println("Nenhuma partição encontrada.");
        return;
    }

    int contador = 0;

    while (iterator != NULL) {
        const esp_partition_t *part = esp_partition_get(iterator);

        if (part != NULL) {
            contador++;

            Serial.print("#");
            Serial.println(contador);

            Serial.print("  Label: ");
            Serial.println(part->label);

            Serial.print("  Tipo: ");
            Serial.println(partitionTypeName(part->type));

            Serial.print("  Subtipo: ");
            if (part->type == ESP_PARTITION_TYPE_APP) {
                Serial.println(partitionAppSubtypeName(part->subtype));
            } else if (part->type == ESP_PARTITION_TYPE_DATA) {
                Serial.println(partitionDataSubtypeName(part->subtype));
            } else {
                Serial.println("OUTRO");
            }

            Serial.print("  Endereco: 0x");
            Serial.println(part->address, HEX);

            Serial.print("  Tamanho: ");
            Serial.print(part->size);
            Serial.println(" bytes");

            Serial.print("  Read-only: ");
            Serial.println(part->readonly ? "SIM" : "NAO");

            Serial.println();
        }

        iterator = esp_partition_next(iterator);
    }

    esp_partition_iterator_release(iterator);
}

