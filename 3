void testePSRAM() {
    titulo("4. PSRAM");

    size_t total = ESP.getPsramSize();

    if (total == 0) {
        Serial.println("PSRAM: NAO DETECTADA");
        return;
    }

    Serial.println("PSRAM: DETECTADA");

    Serial.print("Total: ");
    Serial.print(total / 1024);
    Serial.println(" KB");

    Serial.print("Livre: ");
    Serial.print(ESP.getFreePsram() / 1024);
    Serial.println(" KB");

    Serial.print("Maior bloco livre: ");
    Serial.print(
        heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM)
    );
    Serial.println(" bytes");

    // Teste pequeno, temporário e somente em RAM.
    const size_t testeTamanho = 128;

    uint8_t *buffer = static_cast<uint8_t *>(
        ps_malloc(testeTamanho)
    );

    if (buffer == nullptr) {
        Serial.println("Teste PSRAM: FALHA AO ALOCAR 128 bytes");
        return;
    }

    for (size_t i = 0; i < testeTamanho; i++) {
        buffer[i] = static_cast<uint8_t>(i ^ 0x5A);
    }

    bool sucesso = true;

    for (size_t i = 0; i < testeTamanho; i++) {
        if (buffer[i] != static_cast<uint8_t>(i ^ 0x5A)) {
            sucesso = false;
            break;
        }
    }

    free(buffer);

    Serial.print("Teste temporário leitura/escrita PSRAM: ");
    Serial.println(sucesso ? "OK" : "FALHA");
}

