const char *resetReasonName(esp_reset_reason_t reason) {
    switch (reason) {
        case ESP_RST_UNKNOWN:
            return "UNKNOWN";

        case ESP_RST_POWERON:
            return "POWER-ON";

        case ESP_RST_EXT:
            return "EXTERNAL RESET";

        case ESP_RST_SW:
            return "SOFTWARE RESET";

        case ESP_RST_PANIC:
            return "PANIC / CRASH";

        case ESP_RST_INT_WDT:
            return "INTERRUPT WATCHDOG";

        case ESP_RST_TASK_WDT:
            return "TASK WATCHDOG";

        case ESP_RST_WDT:
            return "WATCHDOG";

        case ESP_RST_DEEPSLEEP:
            return "DEEP SLEEP";

        case ESP_RST_BROWNOUT:
            return "BROWNOUT / QUEDA DE TENSÃO";

        case ESP_RST_SDIO:
            return "SDIO RESET";

        default:
            return "OUTRO / DESCONHECIDO";
    }
}

const char *partitionTypeName(uint8_t type) {
    switch (type) {
        case ESP_PARTITION_TYPE_APP:
            return "APP";

        case ESP_PARTITION_TYPE_DATA:
            return "DATA";

        default:
            return "OUTRO";
    }
}

const char *partitionDataSubtypeName(uint8_t subtype) {
    switch (subtype) {
        case ESP_PARTITION_SUBTYPE_DATA_OTA:
