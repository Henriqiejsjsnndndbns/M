// ============================================================

void imprimirMAC(const uint8_t *mac) {
    for (int i = 0; i < 6; i++) {
        if (i > 0) {
            Serial.print(":");
        }

        if (mac[i] < 16) {
            Serial.print("0");
        }

        Serial.print(mac[i], HEX);
    }

    Serial.println();
}

void diagnosticoMAC() {
    titulo("7. IDENTIFICAÇÃO / MAC");

    uint8_t mac[6];

    esp_err_t resultado =
        esp_read_mac(mac, ESP_MAC_WIFI_STA);

    Serial.print("MAC Wi-Fi STA: ");

    if (resultado == ESP_OK) {
        imprimirMAC(mac);
    } else {
        Serial.println("NAO DISPONIVEL");
    }

    WiFi.mode(WIFI_STA);

    Serial.print("Wi-Fi MAC via Arduino: ");
    Serial.println(WiFi.macAddress());

    Serial.print("AP MAC via Arduino: ");
    Serial.println(WiFi.softAPmacAddress());

    Serial.print("MAC bruto: ");
    if (resultado == ESP_OK) {
        imprimirMAC(mac);
    }
}

// ============================================================
// WI-FI
// ============================================================

void diagnosticoWiFi() {
    titulo("8. WI-FI");

    Serial.println("Nenhuma conexão será feita.");
    Serial.println("Somente será executado um scan.");

    WiFi.mode(WIFI_STA);
    WiFi.disconnect(true, false);

    delay(500);

    int quantidade = WiFi.scanNetworks(
        false,
        true,
        false,
        300
    );

    if (quantidade < 0) {
        Serial.println("Falha no scan Wi-Fi.");
        return;
    }

    Serial.print("Redes encontradas: ");
    Serial.println(quantidade);

    for (int i = 0; i < quantidade; i++) {

        Serial.print("#");
        Serial.println(i + 1);

        Serial.print("  SSID: ");
        Serial.println(WiFi.SSID(i));

        Serial.print("  RSSI: ");
        Serial.print(WiFi.RSSI(i));
        Serial.println(" dBm");

        Serial.print("  Canal: ");
        Serial.println(WiFi.channel(i));

        Serial.print("  Criptografia: ");
        Serial.println(WiFi.encryptionType(i));

        Serial.print("  BSSID: ");
        Serial.println(WiFi.BSSIDstr(i));

        Serial.println();
    }

    WiFi.scanDelete();
}

